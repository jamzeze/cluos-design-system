{
  "name": "@cluos/design-system",
  "version": "1.0.0",
  "description": "CluOS design system (cluos-v2) — tokens, componentes de referência, ativos de marca, princípios de UX e padrões de produto para todos os repositórios CluOS",
  "main": "tokens/tokens.js",
  "types": "tokens/index.ts",
  "files": [
    "tokens/",
    "brand-assets/",
    "patterns/",
    "examples/",
    "cluos.css",
    "DESIGN-preview.html",
    "DESIGN.md",
    "DESIGN-WORKFLOW.md",
    "AGENT-BRIEF.md",
    "PRODUCT-SIMPLICITY-CANON.md",
    "APPLE-INSPIRED-PRODUCT-UX.md",
    "PRODUCT-PATTERNS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./tokens/index.ts",
      "import": "./tokens/tokens.js",
      "require": "./tokens/tokens.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./fonts.css": "./tokens/fonts.css",
    "./cluos.css": "./cluos.css",
    "./tailwind-preset": "./tokens/tailwind-preset.js",
    "./tailwind.css": "./tokens/tailwind.css",
    "./shadcn.css": "./tokens/shadcn.css",
    "./design.json": "./tokens/design.json",
    "./cluos-v2.yaml": "./tokens/cluos-v2.yaml",
    "./mms-canonical.yaml": "./tokens/mms-canonical.yaml",
    "./AGENT-BRIEF.md": "./AGENT-BRIEF.md",
    "./brand-assets/*": "./brand-assets/*",
    "./patterns/*": "./patterns/*",
    "./examples/*": "./examples/*",
    "./DESIGN-preview.html": "./DESIGN-preview.html",
    "./DESIGN.md": "./DESIGN.md"
  },
  "scripts": {
    "build:tokens": "python3 scripts/build-tokens.py",
    "build:preview": "python3 scripts/build-preview.py",
    "build": "python3 scripts/build-tokens.py && python3 scripts/build-preview.py",
    "test": "python3 scripts/build-tokens.py --check && python3 scripts/build-preview.py --check && python3 scripts/test-contrast.py"
  },
  "keywords": [
    "cluos",
    "design-system",
    "design-tokens",
    "brand"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jamzeze/cluos-design-system.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
